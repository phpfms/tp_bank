@startuml TPBank_UseCase_Global

left to right direction
skinparam packageStyle rectangle

actor "Utilisateur" as User

rectangle "TP Bank" {

  usecase "Gestion des clients" as UC1
  usecase "Gestion des comptes" as UC2
  usecase "Gestion des comptes bancaires" as UC3
  usecase "Gestion des opérations bancaires" as UC4

}

User --> UC1
User --> UC2
User --> UC3
User --> UC4

@enduml