@startuml GestionHistorique

left to right direction

actor "Utilisateur" as User

rectangle "TP Bank - Historique des Opérations" {

    usecase "Consulter\n l'historique" as UC1

    usecase "Sélectionner\n un compte" as UC2

    usecase "Afficher les\n opérations" as UC3

}

User --> UC1

UC1 .> UC2 : <<include>>
UC1 .> UC3 : <<include>>

@enduml